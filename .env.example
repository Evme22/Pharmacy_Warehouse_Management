# MySQL Docker configuration
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_PASSWORD=change_me_app_password

# Flask database connection
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=Pharmacy_Warehouse
DB_USER=pharmacy_app

# Flask session secret
FLASK_SECRET_KEY=replace_with_your_own_random_secret

# Optional Docker host port
MYSQL_HOST_PORT=3307
